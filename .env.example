# Copy to .env for local development. Never commit the real .env.

COPILOT_ENVIRONMENT=local
COPILOT_LOG_LEVEL=INFO

COPILOT_DATABASE_URL=postgresql+psycopg://copilot:copilot@localhost:5432/copilot

# COPILOT_LLM_PROVIDER is wired up in Phase 3 — safe to leave as-is.
COPILOT_LLM_PROVIDER=anthropic

# COPILOT_EMBEDDING_PROVIDER: "openai" (real) or "fake" (deterministic, no
# API key required — used by tests, and lets this repo run fully
# standalone without an OpenAI key). Set COPILOT_OPENAI_API_KEY when
# using "openai".
COPILOT_EMBEDDING_PROVIDER=fake
COPILOT_OPENAI_API_KEY=

COPILOT_CONFIDENCE_THRESHOLD=0.55
COPILOT_DOCUMENT_STORAGE_PATH=data/raw/documents

# Optional, Phase 6+. Leave unset for standalone runs (NFR1) — this repo
# must run correctly with no other Enterprise AI Platform repo present.
COPILOT_PREDICTIVE_MAINTENANCE_BASE_URL=
